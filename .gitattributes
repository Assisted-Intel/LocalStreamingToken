# Normalize line endings so the repo is identical on Windows, macOS, and Linux.
# Without this, a clone on a non-Windows machine can show every file as modified.
* text=auto eol=lf

# Windows-only helpers keep CRLF if any are ever added.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary content.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.duckdb binary
*.enc binary
