# Local Streaming Token — keep secrets and personal data out of the repo.

# Settings hold API keys and provider credentials — never publish them.
# Use settings/* (not settings/) so the example file can be re-included: git
# cannot un-ignore a file whose parent directory itself is ignored.
settings/*
!settings/settings.example.json
# The encryption keyfile (password-wrapped data key + Flask secret) — never publish it.
# (Already covered by settings/* above; listed explicitly for clarity.)
settings/app_key.enc

# Any encrypted artifact, wherever it lives. This is a safety net: the keyfile and
# the database credential vault are already covered by settings/* above, but this
# rule survives someone editing those lines without understanding the un-ignore idiom.
*.enc

# User data: chats (can be large + personal), presets, libraries, personas, RAG store.
# Created on first run by app/core.py; a fresh clone has no data/ at all.
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / type-checker / linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# DuckDB vector + staging stores and their write-ahead logs. Belt-and-braces: these
# live under data/ (ignored above), but the rule keeps them out if one is ever
# written elsewhere.
*.duckdb
*.duckdb.wal
*.wal

# LanceDB vector store. The store is a DIRECTORY (holding _versions/, _indices/,
# _transactions/) but its data fragments are individual `*.lance` FILES, so both forms
# are matched — a bare `*.lance/` would let a loose fragment through, and a fragment
# holds raw chunk text and embeddings.
#
# This matters more than the DuckDB rule above: a Lance store is PLAINTEXT. The RAG
# corpus is private and unique to each user, so it must never reach a public repo.
# It lives under data/ (ignored above); this is the belt-and-braces net for a store
# written anywhere else.
*.lance
*.lance/

# Persona per-persona binary stores, under the active data profile. Definitions live
# in persona.xml (exported explicitly); knowledge/memory vectors are a derived cache
# and originals are re-ingested and re-embedded on import.
data/profiles/*/personas/*/knowledge/
data/profiles/*/personas/*/memories/
data/profiles/*/personas/*/sources/

# Fetched-source caches under the active data profile: one encrypted file per YouTube
# video and per podcast episode. Encrypted at rest and fully rebuildable by re-fetching
# the feed or video, so they are cache, not data. Already covered by data/ above; spelled
# out for the same reason the persona stores are, and because an episode transcript can
# carry hours of someone else's copyrighted audio as text.
data/profiles/*/youtube_cache/
data/profiles/*/rss_cache/

# Phase checkpoints (used when git history isn't the chosen rollback mechanism).
backups/

# Logs and packaging output
*.log
dist/
build/

# Local AI-assistant context. Useful on this machine, not part of the public repo.
CLAUDE.md
.claude/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
